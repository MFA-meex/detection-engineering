// Name: Suspicious Azure Key Vault Secret Access
// Author: MFA meex
// Date: 2026-05-12
// Description: Detects abnormal Azure Key Vault secret retrieval, enumeration, or decryption activity.
// Reference: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/azkvauditlogs
// Note: Tune for known automation accounts, managed identities, and trusted IP ranges.

AZKVAuditLogs
| where ResultType == "Success"
// Operations for possible cred access or key abuse
| where OperationName in (
    "SecretGet",
    "KeyGet",
    "VaultGet",
    "SecretList",
    "KeyList",
    "KeyUnwrap",
    "KeyDecrypt"
)
// Normaliz identities across users, service principals, and managed identities
| extend Actor = coalesce(
    tostring(Identity.claim["http://schemas.microsoft.com/identity/claims/upn"]),
    tostring(Identity.claim["http://schemas.microsoft.com/identity/claims/objectidentifier"]),
    tostring(Identity.claim.appid),
    "UnknownIdentity"
)
| extend AccessedItem = coalesce(tostring(Id), tostring(RequestUri))
| summarize
    AccessCount = count(),
    Vaults = make_set(_ResourceId, 10),
    AccessedItems = make_set(AccessedItem, 10),
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated)
    by CallerIpAddress,
       Actor,
       bin(TimeGenerated, 1h)
// Tune based on Org's workflows
| where AccessCount >= 20
| project
    StartTime,
    EndTime,
    Actor,
    CallerIpAddress,
    AccessCount,
    Vaults,
    AccessedItems
| sort by AccessCount desc
