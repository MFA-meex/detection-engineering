// Name: Credential Manipulation
// Author: MFA meex
// Date: 2026-05-11
// Description: Detects creation or modification of access keys, secrets, or service principal credentials.

AuditLogs
| where ActivityDisplayName has_any ("Add password to service principal", "Add credential", "Update application", "Add key")
// Extract the target application name and the initiating actor
| extend App = tostring(TargetResources[0].displayName)
| extend Actor = tostring(InitiatedBy.user.userPrincipalName)
// Aggregate the credential modification events by actor over a 1-hour window
| summarize
    KeyEvents = count(),
    Apps = make_set(App, 10),
    StartTime = min(TimeGenerated) // Capture TimeGenerated before binning
    by Actor, bin(TimeGenerated, 1h)
| where KeyEvents >= 1
| project StartTime, Actor, Apps, KeyEvents
